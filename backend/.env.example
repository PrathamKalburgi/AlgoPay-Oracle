# ─── Required ────────────────────────────────────────────────────────────────

# 25-word Algorand mnemonic for the oracle signing account.
# This account must be funded (for transaction fees and box MBR).
# Get a funded TestNet account from: https://bank.testnet.algorand.network
ORACLE_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24 word25

# ─── Algorand ─────────────────────────────────────────────────────────────────

# Network: localnet | testnet | mainnet (default: testnet)
ALGO_NETWORK=testnet

# Deployed AlgoPayOracle contract App ID.
# Leave unset to run in anchor mode (proofs stored in note field, no contract verification).
ALGO_APP_ID=

# ─── Server ───────────────────────────────────────────────────────────────────

NODE_ENV=development

# Public server port (internet-facing). Default: 5000
PORT=5000

# Admin server port (localhost only — never expose publicly). Default: 5001
ADMIN_PORT=5001

# Secret key for admin endpoints (X-Admin-Key request header).
# Required in production. Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Comma-separated allowed CORS origins for the public server.
# Required in production. In development defaults to localhost.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Demo mode ────────────────────────────────────────────────────────────────

# Set to true to enable simulated payments (no real payment gateway required).
# Automatically disabled when NODE_ENV=production.
DEMO_MODE=true

# ─── Razorpay (optional) ──────────────────────────────────────────────────────

# Razorpay API credentials. Get from: https://dashboard.razorpay.com
# Use test keys (rzp_test_...) for development.
# If not set, server falls back to demo mode (if DEMO_MODE=true).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
