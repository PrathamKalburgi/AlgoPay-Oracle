{
  "name": "@algopayoracle/oracle-sdk",
  "version": "1.0.6",
  "description": "Programmable payment oracle SDK — bridge fiat payments to Algorand smart contracts",
  "main": "src/index.js",
  "bin": {
    "algopay": "bin/algopay.js"
  },
  "files": [
    "src",
    "examples",
    "bin",
    "README.md"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "example": "node examples/quickstart.js",
    "example:webhook": "node examples/express-webhook.js",
    "lint": "node --check src/index.js src/AlgoPayClient.js src/OracleSigner.js",
    "prepublishOnly": "npm test && npm run lint"
  },
  "keywords": [
    "algorand",
    "oracle",
    "payments",
    "upi",
    "razorpay",
    "web3",
    "blockchain",
    "ed25519",
    "smart-contract"
  ],
  "author": "AlgoPay Oracle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrathamKalburgi/AlgoPay-Oracle.git"
  },
  "homepage": "https://github.com/PrathamKalburgi/AlgoPay-Oracle#readme",
  "peerDependencies": {
    "algosdk": ">=3.0.0"
  },
  "devDependencies": {
    "algosdk": "^3.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.0.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "require": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./validate": {	
      "require": "./src/validate.js"
    },
    "./errors": {
      "require": "./src/errors.js"
    },
    "./adapters": {
      "require": "./src/adapters/index.js"
    }
  }
}