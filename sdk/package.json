{
  "name": "@algopayoracle/oracle-sdk",
  "version": "1.0.5",
  "description": "Programmable payment oracle SDK — bridge fiat payments to Algorand smart contracts",
  "main": "src/index.js",
  "files": [
    "src",
    "examples",
    "README.md"
  ],
  "scripts": {
    "test": "node --test examples/quickstart.js",
    "test:unit": "node --test",
    "test:integration": "ALGO_NETWORK=localnet node --test",
    "example": "node examples/express-webhook.js",
    "lint": "node --check src/index.js src/AlgoPayClient.js src/OracleSigner.js",
    "prepublishOnly": "node --check src/index.js && echo 'Pre-publish checks passed'"
  },
  "keywords": [
    "algorand",
    "oracle",
    "payments",
    "upi",
    "razorpay",
    "web3",
    "blockchain",
    "ed25519",
    "smart-contract"
  ],
  "author": "AlgoPay Oracle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PrathamKalburgi/AlgoPay-Oracle"
  },
  "homepage": "https://github.com/PrathamKalburgi/AlgoPay-Oracle#readme",
  "peerDependencies": {
    "algosdk": ">=3.0.0"
  },
  "devDependencies": {
    "algosdk": "^3.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.0.0",
    "dotenv": "^16.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "require": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./validate": {
      "require": "./src/validate.js"
    },
    "./errors": {
      "require": "./src/errors.js"
    }
  }
}
